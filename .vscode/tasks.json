{
  // Two dev sessions live in here.
  //
  //   `dev`          — Node runtime. Two terminals: backend (API, workflow Worker, events
  //                    Worker, cron Worker) and frontend (store, admin).
  //   `dev: workerd` — workerd runtime. One terminal, three panes: API under `wrangler dev`, store,
  //                    admin.
  //
  // Both run from Cmd+Shift+P → "Tasks: Run Task". `dev` additionally answers to Cmd+Shift+B, not
  // through a keybinding but by being the default build task below — and VS Code allows exactly one
  // of those, so `dev: workerd` cannot have it too. Workspaces cannot ship keybindings either
  // (keybindings.json is user-level only), so a shortcut for the workerd session is something each
  // person adds to their own keybindings.json:
  //
  //   { "key": "...", "command": "workbench.action.tasks.runTask", "args": "dev: workerd" }
  //
  // `presentation.group` is the whole trick: every task sharing a group name opens as a split pane
  // inside one terminal rather than as its own, so a group name is a terminal and its members are
  // that terminal's panes. `dev` uses two — `dev-backend` and `dev-frontend` — which is why it comes
  // up as two entries in the terminal list, split four ways and two ways, instead of one terminal
  // split six ways where every pane is too narrow to read a stack trace.
  //
  // `panel: "dedicated"` keeps each pane bound to its own task across reruns, so a restarted store
  // reuses the store pane instead of stacking a new one beside it. Every session uses group names of
  // its own so a leftover pane from one never splits into another's terminal.
  "version": "2.0.0",
  "tasks": [
    {
      // The one to run. Infra first and in sequence, because the API and the Worker both fail on a
      // cold Postgres and the Worker additionally needs Temporal reachable to register itself.
      "label": "dev",
      "dependsOn": ["dev: infra", "dev: apps"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      // Split out from `dev` only so the six below start in parallel while still sitting behind
      // the infra step — `dependsOrder` applies per task, so one list cannot mix the two orders.
      "label": "dev: apps",
      "dependsOn": ["dev: api", "dev: worker", "dev: events", "dev: cron", "dev: store", "dev: admin", "dev: open"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      // Runs alongside the six rather than after them, because it waits on the ports itself —
      // sequencing it would mean nothing starts until the browser is open. Deliberately in neither
      // presentation group: a member that exits after a few seconds would leave a dead pane wedged
      // into a terminal the others are still using. Delete it from `dev: apps` to stop opening tabs.
      "label": "dev: open",
      "type": "shell",
      "command": "./scripts/dev-open.sh",
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    },
    {
      // Stopping the compose Workers is not tidiness. `worker` polls `proteus`, `events-worker`
      // polls `proteus-events` and `cron-worker` polls `proteus-cron`, and so do the three panes
      // below; whichever is free claims the task, so leaving them up means edits appear to apply at
      // random — to a step, to a subscriber or to a job.
      // `--wait` blocks on the healthchecks, which is what makes the sequence above worth having.
      "label": "dev: infra",
      "type": "shell",
      "command": "docker compose -f apps/backend/docker-compose.yml up -d --wait postgres temporal temporal-ui && docker compose -f apps/backend/docker-compose.yml stop worker events-worker cron-worker",
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    },
    {
      "label": "dev: api",
      "type": "shell",
      "command": "pnpm --filter backend run dev",
      "isBackground": true,
      "presentation": {
        "group": "dev-backend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      // `worker:dev`, not `worker` — it boots via `worker.dev.ts`, which regenerates `registry.gen.ts`
      // and then runs the Worker under `tsx watch`. That generated file imports every workflow, so
      // editing a step action reloads in ~5s; `--include` on `src/workflows/**` is what makes a
      // brand-new workflow file reload too, since the watcher otherwise only follows modules already
      // in the graph. The SIGTERM handler in `worker.ts` drains the in-flight step first, so a restart
      // mid-execution finishes that step rather than losing it.
      "label": "dev: worker",
      "type": "shell",
      "command": "pnpm --filter backend run worker:dev",
      "isBackground": true,
      "presentation": {
        "group": "dev-backend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      // The event bus, and a separate process from the pane above on purpose: it polls
      // `proteus-events` while the Worker polls `proteus`, so a burst of subscriber deliveries
      // cannot leave a shopper's `authorize-payment` step waiting for a slot. Without this pane a
      // publish still succeeds and the activity waits durably on a queue nobody reads — the
      // "No workers polling" banner in the Temporal UI is what that looks like.
      //
      // `worker:events:dev`, not `worker:events` — it boots via `worker.dev.ts`, which regenerates
      // `src/subscribers/registry.gen.ts` and then runs the Worker under `tsx watch`, exactly as
      // `dev: worker` does. `--include` on `src/subscribers/**` is what makes a brand-new subscriber
      // file register without a manual `subscribers:generate`; the generated file itself is excluded
      // from the watch, or writing it would restart the Worker that just wrote it.
      //
      // The `events-worker` compose service keeps the production script on purpose: a watcher inside
      // a container never fires, because the bind mount carries writes but not filesystem events.
      //
      // It refuses to boot when the server has `activity.enableStandalone` off, which a Temporal
      // container older than `dynamicconfig/development-sql.yaml` will — recreate it rather than
      // reading the refusal as a broken task.
      "label": "dev: events",
      "type": "shell",
      "command": "pnpm --filter backend run worker:events:dev",
      "isBackground": true,
      "presentation": {
        "group": "dev-backend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      // The scheduler, and a separate process from the two panes above so that the three slot pools
      // stay separate: it polls `proteus-cron` while they poll `proteus-events` and `proteus`.
      // ADR-0029 has the reasoning.
      //
      // This pane owns cron end to end: it reconciles every Schedule in `src/jobs/` at boot and then
      // answers the runs they start. Without it there are no Schedules at all — which is the point,
      // since a Schedule nothing can run was the failure this arrangement removes. The API process
      // does not touch cron.
      //
      // `worker:cron:dev` boots via `worker.dev.ts`, which regenerates `src/jobs/registry.gen.ts` and
      // then runs the Worker under `tsx watch` — the same shape as the other two panes. `--include`
      // on `src/jobs/**` is what makes a brand-new job file reload at all, and the generated file is
      // excluded so writing it cannot restart the Worker that just wrote it. A restart
      // re-reconciles, so editing a cron expression and editing a handler take effect together.
      //
      // The `cron-worker` compose service keeps the production script, for the reason `dev: events`
      // gives: a watcher inside a container never fires.
      "label": "dev: cron",
      "type": "shell",
      "command": "pnpm --filter backend run worker:cron:dev",
      "isBackground": true,
      "presentation": {
        "group": "dev-backend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "dev: store",
      "type": "shell",
      "command": "pnpm --filter store run dev",
      "isBackground": true,
      "presentation": {
        "group": "dev-frontend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "dev: admin",
      "type": "shell",
      "command": "pnpm --filter admin run dev",
      "isBackground": true,
      "presentation": {
        "group": "dev-frontend",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },

    {
      // The same session against the runtime that actually ships to Cloudflare. Three panes, not
      // four: `resolveWorkflowEngineName` returns `simple` for workerd, so no Temporal Worker exists
      // to run — `@temporalio/*` reaches a native addon workerd cannot load and is kept out of that
      // bundle entirely. A workflow here runs in-process, with compensation but no durability.
      //
      // Mutually exclusive with `dev`: the store and admin panes bind the same 3001/3002. Stop one
      // session before starting the other.
      "label": "dev: workerd",
      "dependsOn": ["dev: workerd infra", "dev: workerd apps"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // Split out for the same reason `dev: apps` is — one list cannot mix sequence and parallel.
      "label": "dev: workerd apps",
      "dependsOn": ["dev: workerd api", "dev: workerd store", "dev: workerd admin", "dev: workerd open"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      // Postgres only. Temporal and its UI are dead weight for this session, and the compose Worker
      // needs no stopping because nothing here enqueues onto `proteus` for it to claim.
      //
      // `wrangler dev` reads `.env.workerd`, which is gitignored and generated from `.env.local`, so
      // a fresh clone has no such file and starts with an undefined DATABASE_URL. The guard covers
      // missing and empty — the two fatal cases — and never truncates a good file, which an
      // unconditional regenerate would do whenever dotenvx fails. It does not cover *stale*: after
      // editing `.env.local`, rerun `pnpm run gen:workerd-env` yourself.
      "label": "dev: workerd infra",
      "type": "shell",
      "command": "docker compose -f apps/backend/docker-compose.yml up -d --wait postgres && { [ -s apps/backend/.env.workerd ] || pnpm run gen:workerd-env; }",
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    },
    {
      // No Temporal UI to open, and no API URL either: the backend has no health route, so `curl
      // --fail` against it would 404 forever and never open. `wrangler dev` announces its own
      // readiness in the pane.
      "label": "dev: workerd open",
      "type": "shell",
      "command": "DEV_OPEN_TARGETS='store|http://localhost:3001 admin|http://localhost:3002' ./scripts/dev-open.sh",
      "presentation": { "reveal": "silent", "panel": "shared", "close": true },
      "problemMatcher": []
    },
    {
      // Serves on 8787, which is why the two Vite panes below pin VITE_BACKEND_URL to it rather than
      // to the Node API's 3000. `--test-scheduled` exposes the cron trigger at `/__scheduled` so the
      // jobs in `src/jobs/` can be fired by hand instead of waiting on the minute tick.
      "label": "dev: workerd api",
      "type": "shell",
      "command": "pnpm --filter backend run dev:workerd",
      "isBackground": true,
      "presentation": {
        "group": "dev-workerd",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "dev: workerd store",
      "type": "shell",
      "command": "pnpm --filter store run dev:workerd",
      "isBackground": true,
      "presentation": {
        "group": "dev-workerd",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "dev: workerd admin",
      "type": "shell",
      "command": "pnpm --filter admin run dev:workerd",
      "isBackground": true,
      "presentation": {
        "group": "dev-workerd",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    }
  ]
}
