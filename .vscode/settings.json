{
  // The whole monorepo's editor config, and the only file that can carry it. VS Code reads
  // `.vscode/settings.json` at the *workspace root* only — a per-app copy under `apps/admin` or
  // `apps/store` is never loaded unless that folder is opened as its own root, which nothing here
  // does. Both existed, both were dead, and both have been removed; adding one back changes nothing
  // except where the next person looks for these keys.
  //
  // Deliberately repo settings rather than User settings: "Biome is the formatter" and
  // "routeTree.gen.ts is generated" are true of this repo, not of every project opened on this
  // machine.
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit"
  }
}
