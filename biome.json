{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/*.gen.ts",
      "!**/*.gen.css",
      "!**/src/api/generated",
      "!apps/backend/openapi/openapi-*.json",
      "!apps/backend/structure/dependency-graph.svg",
      "!apps/backend/worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noLeakedRender": "on",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["info"]
          }
        },
        "noFallthroughSwitchClause": "error",
        "noTemplateCurlyInString": "warn",
        "noEmptyBlockStatements": "warn",
        "noForIn": "error",
        "useErrorMessage": "warn"
      },
      "style": {
        "noUselessElse": "warn",
        "noCommonJs": "warn",
        "useNodejsImportProtocol": "warn",
        "noDefaultExport": "warn",
        "useComponentExportOnlyModules": "off",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "enumMember"
                },
                "formats": ["CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": "(?:\\$)?(.*)",
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "classProperty",
                  "modifiers": ["static"]
                },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              }
            ]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*skeleton*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["**/use-*-table.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/backend/src/framework/logger/console-logger.ts", "apps/backend/tests/setup/setup-test-env.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/icons/src/build-icons/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/backend/src/core/logger/noop-logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/backend/src/framework/temporal/__tests__/payload-converter.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/routes/**",
        "**/*.config*.ts",
        "**/database.config.ts",
        "**/src/api/**/definitions.ts",
        "apps/backend/src/modules/*/index.ts",
        "apps/backend/src/providers/*/index.ts",
        "apps/backend/src/index.workerd.ts",
        "packages/testing/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/index.ts",
        "packages/utils/src/index.ts",
        "packages/icons/src/index.ts",
        "packages/testing/index.ts",
        "packages/http-schemas/src/admin/index.ts",
        "packages/http-schemas/src/auth/index.ts",
        "packages/http-schemas/src/store/index.ts",
        "apps/backend/src/link-modules/modules-definitions.ts",
        "apps/backend/src/test-exports.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/backend/**"],
      "linter": {
        "domains": {
          "drizzle": "all",
          "test": "recommended",
          "types": "all",
          "react": "none"
        }
      }
    },
    {
      "includes": ["apps/admin/**", "apps/store/**", "packages/ui/**"],
      "linter": {
        "domains": {
          "react": "recommended",
          "tailwind": "all",
          "types": "all",
          "drizzle": "none"
        },
        "rules": {
          "correctness": {
            "noNestedComponentDefinitions": "error"
          },
          "nursery": {
            "useSortedClasses": {
              "level": "warn",
              "fix": "safe",
              "options": {
                "functions": ["clsx", "cva", "cx"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/admin/**",
        "apps/store/**",
        "!apps/store/src/api/generated/**",
        "!apps/store/src/routeTree.gen.ts",
        "!apps/store/src/router.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": {
              "level": "error",
              "options": {
                "style": "type"
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
