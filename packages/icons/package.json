{
  "name": "@proteus/icons",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:icons": "node ./src/build-icons/cli.ts --input=./assets --output=. --templateSrc=./scripts/export-template.ts --renderUniqueKey --iconFileExtension=.ts --exportFileName=index.gen.ts --exportNameSuffix=Icon --importFileExtension=.ts && biome format --write ./icons"
  },
  "dependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/minimist": "^1.2.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "minimist": "^1.2.8",
    "svgson": "^5.3.1",
    "typescript": "catalog:"
  }
}
