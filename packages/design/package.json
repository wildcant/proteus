{
  "name": "@proteus/design",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens/tokens.gen.css",
    "./figcraft-set": "./src/figcraft-set.ts",
    "./components/*.json": "./figcraft/components/*.json"
  },
  "scripts": {
    "tokens": "node src/cli.ts tokens",
    "tokens:export": "node src/cli.ts tokens --export",
    "tokens:check": "node src/cli.ts tokens --check",
    "components": "node src/cli.ts components",
    "components:export": "node src/cli.ts components --export",
    "components:check": "node src/cli.ts components --check",
    "design-md": "node src/cli.ts design-md",
    "design-md:check": "node src/cli.ts design-md --check",
    "flow": "node src/cli.ts flow",
    "flow:export": "node src/cli.ts flow --export",
    "flow:check": "node src/cli.ts flow --check",
    "icons": "node src/cli.ts icons",
    "icons:export": "node src/cli.ts icons --export",
    "icons:check": "node src/cli.ts icons --check",
    "brand": "node src/cli.ts brand",
    "brand:export": "node src/cli.ts brand --export",
    "brand:check": "node src/cli.ts brand --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
