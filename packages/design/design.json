{
  "snapshot": "figcraft",
  "tokens": {
    "output": {
      "css": "tokens/tokens.gen.css"
    },
    "theme": {
      "collection": "Theme",
      "modes": [
        {
          "mode": "Light",
          "selector": ":root"
        },
        {
          "mode": "Dark",
          "selector": ":root[data-theme=\"dark\"]",
          "media": {
            "query": "(prefers-color-scheme: dark)",
            "selector": ":root:not([data-theme=\"light\"])"
          }
        }
      ]
    },
    "viewport": {
      "collection": "Viewport",
      "modes": [
        {
          "mode": "Mobile",
          "width": 375
        },
        {
          "mode": "Sm",
          "width": 640
        },
        {
          "mode": "Md",
          "width": 768
        },
        {
          "mode": "Desktop",
          "width": 1440
        }
      ],
      "scale": "fluid"
    },
    "textStyles": {
      "form": "doubled"
    }
  },
  "components": {
    "root": "../../apps/store/src",
    "notExported": {
      "Icon": "exported by the icons exporter"
    },
    "notStyledLayers": {
      "Field › exampleInput": "example content: the children are the caller's",
      "Field › exampleError": "example content: the children are the caller's",
      "Field › exampleCheckbox": "example content: the children are the caller's",
      "Field › exampleLabel": "example content: the children are the caller's",
      "RadioGroup › exampleItem": "example content: the children are the caller's",
      "Button › icon": "the caller's icon: the Button sizes any <svg> in it ([&_svg]:size-4) and colours it through currentColor",
      "Popover › tip": "the arrow's ::before square: size calc(16px*sqrt(2)), rotate-45, rounded-tl-arrow, border-popup-ring, bg-surface, centred on the box's bottom edge; hand-written"
    },
    "inline": ["Button"],
    "fullWidth": ["Input", "NativeSelect", "Field", "RadioGroup"],
    "runtimePositions": ["Tooltip › arrow", "Popover › arrow"],
    "inheritedText": {
      "Drawer": "type/body-compact"
    },
    "interactionParts": {
      "QuantityStepper": ["decrement", "increment"],
      "Accordion": ["item"],
      "Pagination": ["previous", "next"],
      "Nav": ["link", "trigger"],
      "RailPanel": ["shopAll", "link"]
    },
    "interactionPrefixes": {
      "QuantityStepper": {
        "hover": "enabled:hover"
      },
      "DropdownMenuItem": {
        "afterCurrent": "[[data-current]+&]"
      }
    }
  },
  "designMd": {
    "output": "../../DESIGN.md",
    "name": "Proteus",
    "description": "The storefront's design system, drawn in the FigCraft design file and generated into code."
  },
  "flow": {
    "output": "../../apps/store/src/navigation/flow.gen.ts",
    "screens": "../../apps/store/src/navigation/screens.ts",
    "routeTree": "../../apps/store/src/routeTree.gen.ts"
  },
  "icons": {
    "set": "Icon",
    "output": "../../apps/store/src/components/ui/icon/icon.glyphs.tsx"
  },
  "brand": {
    "output": "../../apps/store/public"
  }
}
