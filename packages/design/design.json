{
  "snapshot": "figcraft",
  "output": {
    "css": "tokens/tokens.gen.css"
  },
  "theme": {
    "collection": "Theme",
    "modes": [
      {
        "mode": "Light",
        "selector": ":root"
      },
      {
        "mode": "Dark",
        "selector": ":root[data-theme=\"dark\"]",
        "media": {
          "query": "(prefers-color-scheme: dark)",
          "selector": ":root:not([data-theme=\"light\"])"
        }
      }
    ]
  },
  "viewport": {
    "collection": "Viewport",
    "modes": [
      {
        "mode": "Mobile",
        "width": 375
      },
      {
        "mode": "Desktop",
        "width": 1440
      }
    ],
    "scale": "fluid"
  },
  "textStyles": {
    "form": "doubled"
  }
}
