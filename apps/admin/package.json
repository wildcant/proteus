{
  "name": "admin",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenvx run --env-file=../../.env.local -- vite dev --port 3002",
    "dev:workerd": "VITE_BACKEND_URL=http://localhost:8787 dotenvx run --env-file=../../.env.local -- vite dev --port 3002",
    "openapi:client": "orval",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "dotenvx run --env-file=../../.env -- vite build && wrangler pages deploy dist --project-name=proteus-admin",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "dev:test": "dotenvx run --env-file=../../.env.test -- vite dev --port 3012",
    "test:e2e": "dotenvx run --env-file=../../.env.test -- playwright test",
    "test:e2e:dev": "pnpm run test:e2e --ui",
    "check:structure": "depcruise src/ --config structure/.dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@proteus/http-schemas": "workspace:*",
    "@proteus/ui": "workspace:*",
    "@proteus/utils": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/form-core": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "catalog:",
    "qs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-jwt": "^2.1.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@playwright/test": "catalog:",
    "@proteus/frontend-structure": "workspace:*",
    "@proteus/testing": "workspace:*",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "dependency-cruiser": "catalog:",
    "orval": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
