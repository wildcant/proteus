{
  "name": "admin",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenvx run --env-file=../../.env.local -- vite dev --port 3002",
    "dev:workerd": "VITE_BACKEND_URL=http://localhost:8787 dotenvx run --env-file=../../.env.local -- vite dev --port 3002",
    "openapi:client": "orval",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler pages deploy dist --project-name=proteus-admin",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "dev:test": "dotenvx run --env-file=../../.env.test -- vite dev --port 3012",
    "test:e2e": "dotenvx run --env-file=../../.env.test -- playwright test",
    "test:e2e:dev": "npm run test:e2e -- --ui",
    "check:deps": "depcruise src/ --config deps-analyzer/.dependency-cruiser.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@proteus/http-schemas": "*",
    "@proteus/ui": "*",
    "@proteus/utils": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-table": "^8.21.3",
    "qs": "^6.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-jwt": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.62.1",
    "@proteus/testing": "*",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^22.10.2",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "orval": "^8.22.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
