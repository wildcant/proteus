{
  "name": "backend",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/api/index.ts",
    "./test": "./src/test-exports.ts",
    "./test/database-url": "./tests/setup/database-url.ts",
    "./test/fake-gateway": "./tests/mocks/msw/handlers/stripe-wallet.ts"
  },
  "scripts": {
    "dev": "dotenvx run -f ../../.env.local -- tsx --watch src/index.ts",
    "dev:slow": "./scripts/dev-slow-db.sh",
    "dev:test": "NODE_ENV=test MOCKS=true dotenvx run --env-file=../../.env.test -- tsx watch src/index.ts --port ${PORT:-3010}",
    "db:test:prepare": "dotenvx run --env-file=../../.env.test -- tsx scripts/prepare-test-database.ts",
    "dev:test:e2e": "pnpm run db:test:prepare && pnpm run dev:test",
    "dev:workerd": "wrangler dev --test-scheduled --config wrangler.jsonc --env-file .env.workerd",
    "worker": "dotenvx run -f ../../.env.local -- tsx src/core/workflows/temporal/worker.ts",
    "worker:test": "pnpm run workflows:generate && NODE_ENV=test MOCKS=true dotenvx run --env-file=../../.env.test -- tsx src/core/workflows/temporal/worker.ts",
    "worker:dev": "dotenvx run -f ../../.env.local -- tsx watch --include 'src/workflows/**/*.ts' --exclude 'src/core/workflows/temporal/registry.gen.ts' src/core/workflows/temporal/worker.dev.ts",
    "worker:events": "dotenvx run -f ../../.env.local -- tsx src/core/event-bus/temporal/worker.ts",
    "temporal:ping": "dotenvx run -f ../../.env.local -- tsx src/core/temporal/ping.ts",
    "temporal:worker-ready": "dotenvx run -f ../../.env.local --quiet -- tsx scripts/temporal/worker-ready.ts",
    "measure:workflow-payload": "NODE_ENV=test dotenvx run -f ../../.env.test -- tsx scripts/temporal/measure-payload.ts",
    "temporal:crash-resume": "NODE_ENV=test dotenvx run -f ../../.env.test -- tsx scripts/temporal/crash-resume.ts",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "start": "dotenvx run -f ../../.env -- tsx src/index.ts",
    "test": "dotenvx run -f ../../.env.test -- vitest run",
    "test:temporal": "dotenvx run -f ../../.env.test -- vitest run --config vitest.temporal.config.ts",
    "test:temporal:server": "dotenvx run -f ../../.env.test -- vitest run --config vitest.temporal-server.config.ts",
    "test:api": "dotenvx run -f ../../.env.test -- vitest run src/api",
    "test:gate": "dotenvx run -f ../../.env.test -- vitest run src/api src/core/event-bus src/core/utils src/modules/payment src/framework/runtime",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "typecheck": "tsc --noEmit",
    "db:restart": "pnpm run db:reset && pnpm run db:migrate:dev && pnpm run db:seed:dev",
    "stack:reset": "./scripts/reset-stack.sh",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:status": "docker compose ps",
    "db:reset": "PGPASSWORD=postgres dropdb --force -h 127.0.0.1 -U postgres proteus && PGPASSWORD=postgres createdb -h 127.0.0.1 -U postgres proteus",
    "db:generate": "dotenvx run -f ../../.env.local -- sh -c 'for config in src/modules/*/database.config.ts src/link-modules/database.config.ts; do drizzle-kit generate --config=\"$config\" || exit 1; done'",
    "db:migrate": "MIGRATING=true sh -c 'for config in src/modules/*/database.config.ts src/link-modules/database.config.ts; do drizzle-kit migrate --config=\"$config\" || exit 1; done'",
    "db:migrate:dev": "dotenvx run -f ../../.env.local -- pnpm run db:migrate",
    "db:seed:dev": "dotenvx run -f ../../.env.local -- tsx scripts/seed-dev.ts",
    "db:seed:providers": "dotenvx run -f ../../.env -- tsx --dns-result-order=ipv4first scripts/seed-providers.ts",
    "db:migrate:test": "dotenvx run -f ../../.env.test -- pnpm run db:migrate",
    "db:seed:providers:test": "dotenvx run -f ../../.env.test -- tsx scripts/seed-providers.ts",
    "db:seed:markets:test": "dotenvx run -f ../../.env.test -- tsx scripts/seed-markets.ts",
    "db:restore:staging": "./scripts/restore-staging-db.sh",
    "db:diagram": "dotenvx run -f ../../.env.local -- ./scripts/db-diagram/run.sh",
    "openapi:dump:offline": "dotenvx run -f ../../.env.test -- tsx scripts/openapi-dump.ts",
    "check:openapi": "spectral lint openapi/openapi-admin.json openapi/openapi-store.json --ruleset openapi/ruleset.yaml --fail-severity=error",
    "check:errors": "./scripts/check-generic-errors.sh",
    "check:workflow-purity": "tsx scripts/replay-purity.ts",
    "check:workflow-registry": "tsx scripts/generate-workflow-registry.ts --check",
    "workflows:generate": "tsx scripts/generate-workflow-registry.ts",
    "check:subscriber-registry": "tsx scripts/generate-subscriber-registry.ts --check",
    "subscribers:generate": "tsx scripts/generate-subscriber-registry.ts",
    "check:schema-registry": "tsx scripts/generate-schema.ts --check",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "check:schema": "tsx scripts/checks/run.ts",
    "check:structure": "depcruise src/ --config structure/.dependency-cruiser.cjs",
    "check:structure:graph": "depcruise src/ --config structure/.dependency-cruiser.cjs --output-type archi --exclude '(node_modules|__tests__)' --collapse 3 | dot -T svg -o structure/dependency-graph.svg && open structure/dependency-graph.svg"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@dotenvx/dotenvx": "catalog:",
    "@proteus/http-schemas": "workspace:*",
    "@proteus/utils": "workspace:*",
    "@sendgrid/mail": "^8.1.6",
    "@temporalio/activity": "^1.23.0",
    "@temporalio/client": "^1.23.0",
    "@temporalio/common": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "awilix": "^12.0.0",
    "bignumber.js": "catalog:",
    "bullmq": "^6.0.9",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "hono": "^4.12.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0",
    "postgres": "catalog:",
    "qs": "catalog:",
    "resend": "^6.18.1",
    "scrypt-kdf": "catalog:",
    "stripe": "^22.3.2",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^3.0.2",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@playwright/test": "catalog:",
    "@stoplight/spectral-cli": "^6.16.3",
    "@temporalio/testing": "^1.23.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.0",
    "@types/qs": "catalog:",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "^0.31.0",
    "fast-check": "^4.9.0",
    "msw": "^2.15.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
