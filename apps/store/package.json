{
  "name": "store",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenvx run --env-file=../../.env.local -- vite dev --port 3001",
    "dev:workerd": "VITE_BACKEND_URL=http://localhost:8787 dotenvx run --env-file=../../.env.local -- vite dev --port 3001",
    "dev:test": "dotenvx run --env-file=../../.env.test -- vite dev --port 3011 --mode test",
    "test:e2e": "dotenvx run --env-file=../../.env.test -- playwright test",
    "test:e2e:dev": "pnpm run test:e2e --ui",
    "test": "vitest run",
    "generate-routes": "tsr generate",
    "build": "dotenvx run --env-file=../../.env -- vite build",
    "preview:local": "dotenvx run --env-file=../../.env.local -- vite build && dotenvx run --env-file=../../.env.local -- vite preview",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "openapi:client": "orval",
    "check:structure": "depcruise src/ --config structure/.dependency-cruiser.cjs"
  },
  "dependencies": {
    "@proteus/http-schemas": "workspace:*",
    "@proteus/icons": "workspace:*",
    "@proteus/ui": "workspace:*",
    "@proteus/utils": "workspace:*",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.15.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.50",
    "class-variance-authority": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@dotenvx/dotenvx": "catalog:",
    "@faker-js/faker": "catalog:",
    "@playwright/test": "catalog:",
    "@proteus/frontend-structure": "workspace:*",
    "@proteus/testing": "workspace:*",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "^4.1.11",
    "dependency-cruiser": "catalog:",
    "orval": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "catalog:"
  }
}
