{
  "name": "store",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenvx run --env-file=../../.env.local -- vite dev --port 3001",
    "dev:workerd": "VITE_BACKEND_URL=http://localhost:8787 dotenvx run --env-file=../../.env.local -- vite dev --port 3001",
    "dev:test": "dotenvx run --env-file=../../.env.test -- vite dev --port 3011",
    "test:e2e": "dotenvx run --env-file=../../.env.test -- playwright test",
    "test:e2e:dev": "npm run test:e2e -- --ui",
    "generate-routes": "tsr generate",
    "build": "dotenvx run --env-file=../../.env -- vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:static": "dotenvx run --env-file=../../.env -- vite build --config vite.config.static.ts && cp dist/client/_shell.html dist/client/index.html && cp static/_redirects dist/client/_redirects && rm -f .wrangler/deploy/config.json && wrangler pages deploy dist/client --project-name=proteus-store",
    "cf-typegen": "wrangler types",
    "test": "dotenvx run -f ../../.env.test -- vitest run",
    "typecheck": "tsc --noEmit",
    "openapi:client": "orval",
    "check:deps": "depcruise src/ --config deps-analyzer/.dependency-cruiser.cjs"
  },
  "dependencies": {
    "@proteus/http-schemas": "*",
    "@proteus/ui": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "backend": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@dotenvx/dotenvx": "^2.17.1",
    "@playwright/test": "^1.62.1",
    "@proteus/testing": "*",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "orval": "^8.22.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
